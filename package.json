{
  "name": "@pathtx/eslint-dispatcher",
  "version": "0.0.1",
  "author": "Joseph Eagar",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/src/index.d.ts",
  "bin": {
    "eslint-dispatcher": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "lint:eslint": "node src/eslint.ts",
    "lint": "pnpm run lint:eslint",
    "prettier": "pnpm exec prettier src/* package.json -w",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@pathtx/prettier": "3.10.0-dev",
    "@types/node": "^26.4.1",
    "esbuild": "^0.17.2",
    "eslint": "^10.2.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@10.33.2"
}