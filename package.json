  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@pathtx/prettier": "3.10.0-dev",
    "@types/node": "^26.4.1",
    "esbuild": "^0.17.2",
    "eslint": "^10.2.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@10.33.2"
